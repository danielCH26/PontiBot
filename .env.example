# ---------------------------------------------------------------------------
# PontiBot - configuracion  (TODO esto vive en el PC; el robot no lee nada de
# aqui). Copia a .env y ajusta:  cp .env.example .env && chmod 600 .env
# ---------------------------------------------------------------------------

# --- LLM (NVIDIA NIM, endpoint OpenAI-compatible, gratis) ------------------
# La clave se crea gratis en https://build.nvidia.com/settings
LLM_API_KEY=nvapi-TU_CLAVE_AQUI
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# Verificado el 2026-11-04: chat 0.43s | tool calling 0.29s | vision OK | 6/6
LLM_MODEL=nvidia/nemotron-3.5-bolt-e4b
# Alternativa (mas inteligente pero mas lenta y verbosa):
# LLM_MODEL=minimaxai/minimax-m3.1-flash
LLM_LANGUAGE=es
# 0 = predecible | 1 = creativo. Con 0.6 el robot es vivo pero fiable.
LLM_TEMPERATURE=0.6

# ===========================================================================
#  FASE 2 (DIFERIDA): INTERACCION POR VOZ
#  Todo esto queda CONFIGURADO a la espera de retomarlo. Con el chat de
#  consola (python3 voice_agent.py --chat) no hace falta nada de aqui.
# ===========================================================================

# --- Oidos (ASR) -----------------------------------------------------------
# whispercpp   = local y gratis, pero hay que compilar whisper.cpp en el PC
# local_server = whisper-server de whisper.cpp corriendo en el PC
# openai       = API de OpenAI (NVIDIA tambien tiene parakeet gratis)
ASR_BACKEND=whispercpp
ASR_MODEL=base
# Ruta del modelo en ESTA maquina (no /home/pi/... si no estas en el robot)
WHISPER_MODEL_PATH=~/models/ggml-base.bin
ASR_SERVER_URL=http://127.0.0.1:8081
# Dispositivo de captura. Vacio = autodeteccion. tools/bt_headset_pc.sh lo pone.
ASR_DEVICE=

# --- Boca (TTS) -----------------------------------------------------------
# piper = local y natural | espeak = local y robotico | openai = la mejor
TTS_BACKEND=espeak
TTS_VOICE=alloy
# Sumidero de salida. Vacio = autodeteccion. tools/bt_headset_pc.sh lo pone.
TTS_DEVICE=

# --- Robot ----------------------------------------------------------------
# IP del robot tal y como la ve ESTE PC. En modo AP es 192.168.149.1
TONYPI_HOST=192.168.149.1
TONYPI_RPC_PORT=9030
TONYPI_MJPG_PORT=8080
TONYPI_TIMEOUT=10

# --- Memoria de PontiBot --------------------------------------------------
# Fichero donde recuerda el hilo y lo que ha aprendido de ti.
PONTIBOT_MEMORY=~/.pontibot/memory.json
# Cuantas intervenciones conserva en el contexto que ve el modelo.
PONTIBOT_MAX_TURNS=12

# --- Opcional: solo si usas la API de OpenAI para ASR o TTS ---------------
# OPENAI_API_KEY=sk-...
